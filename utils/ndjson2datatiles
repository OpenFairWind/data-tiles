#!/usr/bin/env python3
"""Convert newline-delimited GeoJSON Features to DataTiles without loading JSON framing."""
import argparse, json
from _vector_import import add_common_arguments, normalize_features, run
p=argparse.ArgumentParser(prog="ndjson2datatiles",description=__doc__); add_common_arguments(p)
def load(a):
    features=[]
    for number,line in enumerate(a.input.read_text(encoding="utf-8").splitlines(),1):
        if line.strip():
            try: features.extend(normalize_features(json.loads(line)))
            except (ValueError,json.JSONDecodeError) as exc: raise ValueError(f"invalid GeoJSON on line {number}: {exc}") from exc
    return features
if __name__ == "__main__": raise SystemExit(run(p,load))
